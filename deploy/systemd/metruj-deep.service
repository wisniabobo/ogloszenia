[Unit]
Description=Metruj — pełne przejście wyników (dobowe)

[Service]
Type=oneshot
User=metruj
Group=metruj
WorkingDirectory=/opt/metruj
EnvironmentFile=/opt/metruj/.env
# Przejście do ostatniej strony każdego wyszukiwania — to ono daje komplet
# ofert z kraju. Karty ofert pomijamy (--no-details), bo przy setkach tysięcy
# pozycji to osobny, budżetowany przebieg.
ExecStart=/opt/metruj/.venv/bin/python -m metruj.cli scan --deep --no-details
ExecStartPost=/opt/metruj/.venv/bin/python -m metruj.cli geocode --limit 20000
# Pełne przejście przez wszystkie portale w skali kraju to kilkadziesiąt
# tysięcy zapytań rozłożonych na grzeczne tempo. Doba z zapasem: gdyby się
# nie zmieściło, każde źródło i tak zapisuje się osobno, więc dorobek
# poprzedniej nocy nie przepada.
TimeoutStartSec=72000

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/metruj/data
