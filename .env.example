# Baza danych (domyślnie SQLite w ./data/metruj.db)
OGL_DATABASE_URL=sqlite:///data/metruj.db
# METRUJ_DATABASE_URL=postgresql+psycopg://metruj:haslo@localhost:5432/metruj

# Region startowy
OGL_DEFAULT_VOIVODESHIP=opolskie

# Sieć
OGL_HTTP_TIMEOUT=25
OGL_GLOBAL_CONCURRENCY=8
OGL_RESPECT_ROBOTS=true
METRUJ_USER_AGENT=metruj-bot/2.0 (+https://github.com/wisniabobo/ogloszenia)
# OGL_PROXY_URL=http://user:pass@127.0.0.1:8888

# Prywatność: numery telefonów maskowane na liście (jak w nbot: 537 *** ***)
OGL_MASK_PHONES=true
# Przechowuj wyłącznie skrót numeru zamiast numeru (maks. ochrona RODO)
OGL_STORE_PHONE_HASH_ONLY=false
OGL_PHONE_HASH_SALT=zmien-mnie

# Powiadomienia
# OGL_TELEGRAM_BOT_TOKEN=
# OGL_TELEGRAM_CHAT_ID=
# OGL_WEBHOOK_URL=
# OGL_SMTP_HOST=
# OGL_SMTP_PORT=587
# OGL_SMTP_USER=
# OGL_SMTP_PASSWORD=
# OGL_SMTP_FROM=
# OGL_SMTP_TO=

# API/web
OGL_WEB_HOST=127.0.0.1
OGL_WEB_PORT=8000

# --- wdrożenie (docker compose + Caddy) ---
# DOMAIN=twoja.domena.pl
# ACME_EMAIL=twoj@email.pl

# --- opcjonalnie: Apify dla portali renderowanych w przeglądarce ---
# Katalog aktorów jest publiczny (`ogl apify-actors`), uruchamianie wymaga tokenu.
# OGL_APIFY_TOKEN=

# --- geokodowanie ---
# Własna instancja Nominatim, gdy publiczna przestanie wystarczać:
# OGL_NOMINATIM_URL=https://twoj-nominatim/search
